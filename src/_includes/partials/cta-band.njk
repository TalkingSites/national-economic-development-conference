<section class="section cta-slab slab-scope">
  <div class="wrap cta-grid">
    <div class="stack-s">
      <h2>{{ ctaHeading | default("Join Australia's economic developers in " + event.city) }}</h2>
      <p class="lede" style="color: var(--text-on-slab-soft)">{{ ctaText | default("Registrations for " + site.title + " are open, and study tour places are limited.") }}</p>
    </div>
    <div class="cta-actions">
      {% set btnText = "Register now" %}{% set btnHref = event.registerUrl %}{% set btnStyle = "primary" %}
      {% include "partials/btn.njk" %}
      {% set btnText = "Contact the team" %}{% set btnHref = "mailto:" + site.email %}{% set btnStyle = "on-slab" %}
      {% include "partials/btn.njk" %}
    </div>
  </div>
</section>
