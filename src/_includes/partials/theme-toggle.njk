{# Cycles auto, light, dark. Starts on auto, which follows the operating
   system; site.js swaps which icon is shown and rewrites the label. #}
<button class="theme-toggle" type="button" id="themeToggle" aria-label="Theme follows your system. Switch to light theme.">
  <svg class="theme-toggle__icon" data-theme-icon="auto" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/>
    <path d="M12 3a9 9 0 0 1 0 18Z" fill="currentColor"/>
  </svg>
  <svg class="theme-toggle__icon" data-theme-icon="light" viewBox="0 0 24 24" fill="none" aria-hidden="true" hidden>
    <circle cx="12" cy="12" r="4.1" stroke="currentColor" stroke-width="1.7"/>
    <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
      <path d="M12 2.6v2.3M12 19.1v2.3M21.4 12h-2.3M4.9 12H2.6M18.6 5.4l-1.6 1.6M7 17l-1.6 1.6M18.6 18.6 17 17M7 7 5.4 5.4"/>
    </g>
  </svg>
  <svg class="theme-toggle__icon" data-theme-icon="dark" viewBox="0 0 24 24" fill="none" aria-hidden="true" hidden>
    <path d="M20.5 13.4A8.6 8.6 0 1 1 10.6 3.5a6.9 6.9 0 0 0 9.9 9.9Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
  </svg>
</button>
