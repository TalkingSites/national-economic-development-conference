---
layout: base.njk
styles: ["/assets/css/home.css", "/assets/css/media.css"]
scripts: ["/assets/js/media.js"]
---
<main id="top">

  {% include "partials/hero.njk" %}

  <section class="section">
    <div class="wrap theme-grid">
      <div class="stack">
        <h2 class="h-l">{{ event.theme }}</h2>
        {{ content | safe }}
        <p><a class="link" href="{{ event.flyerUrl }}">Read the five reasons to attend flyer</a></p>
      </div>
      <div class="theme-mark">
        <div class="logo-plate">
          <img src="/assets/images/logo-place-to-prosperity.png" alt="{{ event.theme }}: innovation, transition and investment attraction">
        </div>
        <hr class="rule">
        <p class="label" style="color: var(--text-mute)">Presented by {{ site.presentedBy }}</p>
      </div>
    </div>
  </section>

  {% include "partials/program.njk" %}
  {% include "partials/gallery.njk" %}
  {% include "partials/sponsors.njk" %}

  {% include "partials/cta-band.njk" %}

</main>
